# Database (Required)
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# PostgreSQL Port (Optional) - defaults to 5432 if not specified
# POSTGRES_PORT=5432

# Authentication (Required unless DISABLE_AUTH=true)
BETTER_AUTH_SECRET=your_secret_key  # Use `openssl rand -hex 32` to generate, or visit https://www.better-auth.com/docs/installation
BETTER_AUTH_URL=http://localhost:3000

# Authentication Bypass (Optional - for self-hosted deployments behind private networks)
# DISABLE_AUTH=true  # Uncomment to bypass authentication entirely. Creates an anonymous session for all requests.
                      # Perfect for home/family deployments where everyone shares access.

# Email Verification (Optional - defaults to false)
# EMAIL_VERIFICATION_ENABLED=false  # Set to true to require email verification for new accounts.
                                     # When false, users can sign up with email/password without email confirmation.
                                     # Tip: For home use, leave this disabled for simpler account creation.

# NextJS (Required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Network Access (Optional - for accessing from tablets, phones, other devices)
# ALLOW_LOCAL_NETWORK=true  # Enables access from any device on your local network
                            # When enabled, allows all CORS origins and WebSocket connections
                            # Perfect for home deployments accessed from multiple devices

# Security (Required)
ENCRYPTION_KEY=your_encryption_key  # Use `openssl rand -hex 32` to generate, used to encrypt environment variables
INTERNAL_API_SECRET=your_internal_api_secret # Use `openssl rand -hex 32` to generate, used to encrypt internal api routes
API_ENCRYPTION_KEY=your_api_encryption_key # Use `openssl rand -hex 32` to generate, used to encrypt api keys

# Email Provider (Optional)
# RESEND_API_KEY=  # Uncomment and add your key from https://resend.com to send actual emails
                   # If left commented out, emails will be logged to console instead

# Local AI Models (Optional)
# LLAMACPP_BASE_URL=http://localhost:8080  # URL for local llama.cpp server (llama-server/llama-cli)
# LLAMACPP_API_KEY=                        # Optional bearer token if your llama.cpp instance requires auth
# VLLM_BASE_URL=http://localhost:8000      # Base URL for your self-hosted vLLM (OpenAI-compatible)
# VLLM_API_KEY=                            # Optional bearer token if your vLLM instance requires auth

# Logging (Optional)
# LOG_LEVEL=INFO  # Minimum log level: DEBUG, INFO, WARN, ERROR
                  # In development, defaults to DEBUG (show all)
                  # In production, defaults to ERROR (only errors)
                  # For home deployments, INFO is recommended to see workflow activity

# Admin API (Optional - for self-hosted GitOps)
# ADMIN_API_KEY=  # Use `openssl rand -hex 32` to generate. Enables admin API for workflow export/import.
                  # Usage: curl -H "x-admin-key: your_key" https://your-instance/api/v1/admin/workspaces

# =============================================================================
# HOME DEPLOYMENT QUICK START
# =============================================================================
#
# OPTION 1: Shared Access (simplest - everyone shares one session)
# ----------------------------------------------------------------
# 1. Set DISABLE_AUTH=true (no login required)
# 2. Configure OpenRouter API key in Settings > AI Providers
# 3. Connect integrations (Gmail, Slack, etc.) in Settings > Integrations
# 4. Set LOG_LEVEL=INFO to see workflow activity
#
# Minimal .env for shared access:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"
#   BETTER_AUTH_SECRET=<generate with: openssl rand -hex 32>
#   BETTER_AUTH_URL=http://localhost:3000
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
#   ENCRYPTION_KEY=<generate with: openssl rand -hex 32>
#   INTERNAL_API_SECRET=<generate with: openssl rand -hex 32>
#   API_ENCRYPTION_KEY=<generate with: openssl rand -hex 32>
#   DISABLE_AUTH=true
#   ALLOW_LOCAL_NETWORK=true  # Add this to access from phones/tablets
#   LOG_LEVEL=INFO
#
# OPTION 2: Individual Accounts (each family member has their own login)
# -----------------------------------------------------------------------
# 1. Leave DISABLE_AUTH commented out (auth enabled)
# 2. Leave EMAIL_VERIFICATION_ENABLED=false (no email required)
# 3. Each person signs up with email/password at the login screen
# 4. Workflows and settings are per-user
#
# Minimal .env for individual accounts:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"
#   BETTER_AUTH_SECRET=<generate with: openssl rand -hex 32>
#   BETTER_AUTH_URL=http://localhost:3000
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
#   ENCRYPTION_KEY=<generate with: openssl rand -hex 32>
#   INTERNAL_API_SECRET=<generate with: openssl rand -hex 32>
#   API_ENCRYPTION_KEY=<generate with: openssl rand -hex 32>
#   ALLOW_LOCAL_NETWORK=true  # Add this to access from phones/tablets
#   LOG_LEVEL=INFO
#
# =============================================================================
